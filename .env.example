# ---- LLM provider -----------------------------------------------------------
# mock = fully offline demo (no key needed). Or: openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# ---- Decision policy --------------------------------------------------------
ESCALATION_THRESHOLD=0.55

# ---- Storage ----------------------------------------------------------------
DB_PATH=data/tickets.db

# ---- Email (escalation handoff) ---------------------------------------------
# Keep dry-run on for demos; flip to false + fill SMTP_* to actually send.
EMAIL_DRY_RUN=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support-bot@company.com
SMTP_USE_TLS=false

# ---- Manager routing (category -> email) ------------------------------------
MGR_BILLING=billing-lead@company.com
MGR_TECHNICAL=tech-lead@company.com
MGR_ACCOUNT=account-lead@company.com
MGR_NETWORK=noc-lead@company.com
MGR_OTHER=support-lead@company.com
